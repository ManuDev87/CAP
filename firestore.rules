rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoot() {
      return signedIn() && request.auth.token.role == 'root';
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsUserField() {
      return signedIn() && resource.data.user == request.auth.uid;
    }

    function studentOwnedByCaller(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.teacherId
          == request.auth.uid;
    }

    function isValidPaused(data) {
      return data.keys().hasAll(['user', 'testId', 'mode'])
        && data.user is string
        && data.user == request.auth.uid
        && data.testId is string
        && data.mode in ['examen', 'ayuda'];
    }

    function isValidWrong(data) {
      return data.keys().hasAll(['user', 'questions'])
        && data.user == request.auth.uid
        && data.questions is list;
    }

    match /users/{username} {
      allow read: if isRoot()
        || isOwner(username)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /user_secrets/{username} {
      allow read, write: if false;
    }

    match /centers/{code} {
      allow read: if isRoot()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if false;
    }

    match /paused_tests/{id} {
      // resource == null: first read of a test that was never paused.
      allow get: if isRoot()
        || (signedIn() && resource == null)
        || ownsUserField();
      allow list: if isRoot() || ownsUserField();
      allow create, update: if signedIn() && isValidPaused(request.resource.data);
      allow delete: if isRoot() || ownsUserField();
    }

    match /test_results/{id} {
      allow get: if isRoot()
        || (signedIn() && resource == null)
        || ownsUserField()
        || (isTeacher() && resource != null && studentOwnedByCaller(resource.data.user));
      allow list: if isRoot()
        || ownsUserField()
        || (isTeacher() && studentOwnedByCaller(resource.data.user));
      allow create: if signedIn()
        && request.resource.data.user == request.auth.uid
        && request.resource.data.testId is string;
      allow update: if signedIn()
        && resource.data.user == request.auth.uid
        && request.resource.data.user == request.auth.uid;
      allow delete: if isRoot() || ownsUserField();
    }

    match /score_records/{id} {
      allow get: if isRoot()
        || (signedIn() && resource == null)
        || ownsUserField()
        || (isTeacher() && resource != null && studentOwnedByCaller(resource.data.user));
      allow list: if isRoot()
        || ownsUserField()
        || (isTeacher() && studentOwnedByCaller(resource.data.user));
      allow create: if signedIn()
        && request.resource.data.user == request.auth.uid
        && request.resource.data.testId is string
        && request.resource.data.score is number
        && request.resource.data.passed is bool;
      allow update: if false;
      allow delete: if isRoot() || ownsUserField();
    }

    match /wrong_questions/{username} {
      // resource == null: the student has no wrong-question doc yet.
      allow get: if isOwner(username)
        || isRoot()
        || studentOwnedByCaller(username)
        || (signedIn() && resource == null);
      allow list: if isRoot() || isOwner(username);
      allow create, update: if isOwner(username)
        && isValidWrong(request.resource.data)
        && request.resource.data.user == username;
      allow delete: if isOwner(username) || isRoot();
    }

    match /commissions/{id} {
      allow read: if isRoot()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{id} {
      allow read, write: if false;
    }
  }
}
