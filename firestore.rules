rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // users/{username}
    //   name: string
    //   role: 'student' | 'teacher'
    //   teacherId?: string          // student → owning teacher username
    //   schoolName?: string         // teacher
    //   schoolCode?: string
    //   capTrack?: 'mercancias' | 'viajeros'
    //   trialEndsAt?: timestamp
    //   showSeedBtn?: bool
    //   billing?: 'school' | 'prepaid'
    //   paidUntil?: timestamp   // school pack or prepaid months, then paywall
    //   stripeCustomerId?: string
    //   Password hashes live in user_secrets, never here.
    //
    // user_secrets/{username}       // Admin SDK only
    //   passwordHash: string
    //
    // centers/{schoolCode}
    //   teacherId, schoolName, stripeAccountId?, connectStatus?
    //   seatsPurchased, seatsUsed, packPaidUntil
    //
    // paused_tests/{user}_{testId}_{mode}  { user, testId, mode, ... }
    // test_results/{user}_{testId}         { user, testId, passes, fails }
    // score_records/{autoId}               { user, testId, testName, score, passed, timestamp }
    // wrong_questions/{username}           { user, questions, updatedAt }
    // commissions/{autoId}                 { schoolCode, amount, status, createdAt }
    //
    // Auth: custom tokens. uid = username. claims: role, teacherId, schoolCode.
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isRoot() {
      return signedIn() && request.auth.token.role == 'root';
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function studentOwnedByCaller(studentId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.teacherId
          == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'role'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 120
        && data.role in ['student', 'teacher']
        && !data.keys().hasAny(['password', 'passwordHash']);
    }

    function isValidPaused(data) {
      return data.keys().hasAll(['user', 'testId', 'mode'])
        && data.user is string
        && data.user == request.auth.uid
        && data.testId is string
        && data.mode in ['examen', 'ayuda'];
    }

    function isValidResult(data) {
      return data.keys().hasAll(['user', 'testId'])
        && data.user == request.auth.uid
        && data.testId is string;
    }

    function isValidScore(data) {
      return data.keys().hasAll(['user', 'testId', 'score', 'passed'])
        && data.user == request.auth.uid
        && data.testId is string
        && data.score is number
        && data.passed is bool;
    }

    function isValidWrong(data) {
      return data.keys().hasAll(['user', 'questions'])
        && data.user == request.auth.uid
        && data.questions is list;
    }

    match /users/{username} {
      allow read: if isRoot()
        || isOwner(username)
        || studentOwnedByCaller(username);
      allow create, update, delete: if false;
    }

    match /user_secrets/{username} {
      allow read, write: if false;
    }

    match /centers/{code} {
      allow read: if isRoot()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if false;
    }

    match /paused_tests/{id} {
      allow read: if isRoot()
        || (signedIn() && resource.data.user == request.auth.uid);
      allow create, update: if signedIn() && isValidPaused(request.resource.data);
      allow delete: if signedIn() && resource.data.user == request.auth.uid;
    }

    match /test_results/{id} {
      allow read: if isRoot()
        || (signedIn() && resource.data.user == request.auth.uid)
        || (isTeacher() && studentOwnedByCaller(resource.data.user));
      allow create, update: if signedIn() && isValidResult(request.resource.data)
        && request.resource.data.user == request.auth.uid;
      allow delete: if isRoot()
        || (signedIn() && resource.data.user == request.auth.uid);
    }

    match /score_records/{id} {
      allow read: if isRoot()
        || (signedIn() && resource.data.user == request.auth.uid)
        || (isTeacher() && studentOwnedByCaller(resource.data.user));
      allow create: if signedIn() && isValidScore(request.resource.data);
      allow update: if false;
      allow delete: if isRoot()
        || (signedIn() && resource.data.user == request.auth.uid);
    }

    match /wrong_questions/{username} {
      allow read: if isOwner(username) || isRoot() || studentOwnedByCaller(username);
      allow create, update: if isOwner(username)
        && isValidWrong(request.resource.data)
        && request.resource.data.user == username;
      allow delete: if isOwner(username) || isRoot();
    }

    match /commissions/{id} {
      allow read: if isRoot()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{id} {
      allow read, write: if false;
    }
  }
}
